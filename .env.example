# FinPulse — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Backend ─────────────────────────────────────────────────────────────────

# Database URL — SQLite for local dev, Postgres for production
# SQLite:  sqlite:///./finpulse.db
# Supabase: postgresql://user:password@host:5432/finpulse
DATABASE_URL=sqlite:///./finpulse.db

# How often the scheduler refreshes data (minutes)
REFRESH_INTERVAL_MIN=30

# ── Gemini API (for AI insights bonus feature) ──────────────────────────────

GEMINI_API_KEY=

# ── Dashboard ───────────────────────────────────────────────────────────────

# Backend URL the Streamlit dashboard calls
# Local: http://localhost:8000
# Deployed: https://your-backend.onrender.com
BACKEND_URL=http://localhost:8000
